# Chiavi API dei provider AI (tutte opzionali: si possono inserire anche
# direttamente dall'interfaccia, pannello "⚙️ AI" — restano nel browser).
# Configura solo quelle dei provider che vuoi usare.

# Claude (Anthropic) — https://platform.claude.com
ANTHROPIC_API_KEY=

# Google Gemini (piano GRATUITO) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (piano GRATUITO) — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (molti modelli ":free") — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Endpoint personalizzato compatibile OpenAI
CUSTOM_AI_API_KEY=
